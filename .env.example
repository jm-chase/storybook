# Copy to .env.local and fill in. Never commit the real .env.local.

# Anthropic API key — used for story personalization + the two moderation passes.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for generation + moderation (default; override only if you know why).
STORYBOOK_MODEL=claude-opus-4-8

# Google Gemini — image generation ("Nano Banana"). Used by the consistency spike
# and (later) real character/scene generation. Keep server-side only.
GEMINI_API_KEY=
# Optional override; defaults to gemini-2.5-flash-image.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Print ordering (Lulu Print API, B-9) — all optional until launch ---
# Credentials from developers.lulu.com. Sandbox (default) validates but never
# prints or charges; set LULU_SANDBOX=0 for production.
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_SANDBOX=1
# Lulu SKU string (trim/colour/binding/paper) from their pricing calculator,
# e.g. an 8.5"-square full-colour paperback. Required for quotes and orders.
LULU_POD_PACKAGE_ID=
# Required for real orders only: Lulu downloads our interior/cover PDFs, so
# the app must be reachable at this URL (hosted or tunnelled).
PUBLIC_BASE_URL=
# Spine math override (inches per sheet); default 0.002252 = Lulu standard.
PRINT_SHEET_THICKNESS_IN=
