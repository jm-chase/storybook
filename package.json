{
  "name": "storybook",
  "version": "0.0.1",
  "private": true,
  "description": "Parent-authored, AI-assisted, print-first personalized children's storybook generator (working name TBD).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "spike:consistency": "node --env-file-if-exists=.env.local --import tsx scripts/consistency-spike.ts",
    "validate:gate": "node --env-file-if-exists=.env.local --import tsx scripts/validate-gate.ts",
    "spike:multichar": "node --env-file-if-exists=.env.local --import tsx scripts/multichar-spike.ts",
    "validate:e2e": "node --import tsx scripts/e2e-book.ts",
    "eval:consistency": "node --env-file-if-exists=.env.local --import tsx scripts/eval-consistency.ts",
    "seeds:candidates": "node --env-file-if-exists=.env.local --import tsx scripts/generate-style-seeds.ts",
    "validate:seeds": "node --env-file-if-exists=.env.local --import tsx scripts/validate-seeds.ts",
    "validate:classic": "node --import tsx scripts/validate-classic.ts",
    "seeds:elements": "node --env-file-if-exists=.env.local --import tsx scripts/generate-element-sheets.ts",
    "seeds:gallery": "node --env-file-if-exists=.env.local --import tsx scripts/generate-style-gallery.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@google/genai": "^2.10.0",
    "@react-pdf/renderer": "^4.3.0",
    "next": "^15.5.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
